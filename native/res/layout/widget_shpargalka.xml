<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shp_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="6dp">

    <TextView
        android:id="@+id/shp_prev"
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="‹"
        android:textColor="#38BDF8"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/shp_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shp_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shp_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#7C8AA5"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/shp_cmd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#4ADE80"
            android:textSize="14sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/shp_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#E2E8F0"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/shp_next"
        android:layout_width="30dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="›"
        android:textColor="#38BDF8"
        android:textSize="28sp" />
</LinearLayout>
